<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1f2a36"
    android:orientation="vertical">

    <!-- Barra superior -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp">

        <ImageButton
            android:id="@+id/btnAtrasJuego"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Regresar"
            android:src="@drawable/ic_chevron_right_24"
            android:rotation="180"
            app:tint="@color/white" />

        <TextView
            android:id="@+id/txtCodigoJuego"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPuntuacionJuego"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_examen"
            android:backgroundTint="#1565C0"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:text="0 pts"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#2C3E50" />

    <!-- Contenido del juego (visible durante el juego) -->
    <ScrollView
        android:id="@+id/scrollJuego"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="24dp">

        <LinearLayout
            android:id="@+id/layoutContenidoJuego"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp">

            <!-- Progreso -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <ProgressBar
                    android:id="@+id/progressJuego"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="0dp"
                    android:layout_height="8dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="12dp"
                    android:progressBackgroundTint="#2C3E50"
                    android:progressTint="#1565C0" />

                <TextView
                    android:id="@+id/tvProgresoJuego"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#8FA3B5"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Badge de categoría -->
            <TextView
                android:id="@+id/tvCategoriaJuego"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_badge_examen"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- Tarjeta de pregunta -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#1E2D3D"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <TextView
                    android:id="@+id/tvPreguntaJuego"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingMultiplier="1.4"
                    android:padding="20dp"
                    android:textColor="@color/white"
                    android:textSize="17sp" />
            </androidx.cardview.widget.CardView>

            <!-- Botones de opciones -->
            <Button
                android:id="@+id/btnOpcionA"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:backgroundTint="#1E2D3D"
                android:gravity="start|center_vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="14dp"
                android:textAlignment="textStart"
                android:textColor="@color/white"
                android:textSize="14sp"
                app:cornerRadius="10dp" />

            <Button
                android:id="@+id/btnOpcionB"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:backgroundTint="#1E2D3D"
                android:gravity="start|center_vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="14dp"
                android:textAlignment="textStart"
                android:textColor="@color/white"
                android:textSize="14sp"
                app:cornerRadius="10dp" />

            <Button
                android:id="@+id/btnOpcionC"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:backgroundTint="#1E2D3D"
                android:gravity="start|center_vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="14dp"
                android:textAlignment="textStart"
                android:textColor="@color/white"
                android:textSize="14sp"
                app:cornerRadius="10dp" />

            <Button
                android:id="@+id/btnOpcionD"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:backgroundTint="#1E2D3D"
                android:gravity="start|center_vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="14dp"
                android:textAlignment="textStart"
                android:textColor="@color/white"
                android:textSize="14sp"
                app:cornerRadius="10dp" />

            <!-- Feedback (oculto hasta que el usuario responde) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardFeedbackJuego"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:visibility="gone"
                app:cardBackgroundColor="#0D1F2D"
                app:cardCornerRadius="10dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvFeedbackJuego"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvExplicacionJuego"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingMultiplier="1.4"
                        android:textColor="#B8C6D3"
                        android:textSize="13sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <Button
                android:id="@+id/btnSiguienteJuego"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/btn_Background_Acceder"
                android:text="Siguiente →"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:visibility="gone"
                app:cornerRadius="10dp" />

        </LinearLayout>
    </ScrollView>

    <!-- Pantalla de resultado (oculta durante el juego) -->
    <LinearLayout
        android:id="@+id/layoutResultadoJuego"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvEstrellasResultado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:textColor="#FFD700"
            android:textSize="48sp" />

        <TextView
            android:id="@+id/tvMensajeResultado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:gravity="center"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPuntajeFinal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:gravity="center"
            android:textColor="#8FA3B5"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnReintentarJuego"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:backgroundTint="@color/btn_Background_Acceder"
            android:text="🔄 Volver a intentar"
            android:textColor="@color/white"
            android:textStyle="bold"
            app:cornerRadius="10dp" />

        <Button
            android:id="@+id/btnSalirJuego"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#2C3E50"
            android:text="Salir"
            android:textColor="@color/white"
            app:cornerRadius="10dp" />

    </LinearLayout>

</LinearLayout>
