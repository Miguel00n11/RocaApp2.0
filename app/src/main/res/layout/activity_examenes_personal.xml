<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1f2a36"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Exámenes del personal"
            android:textColor="@color/white"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Elimina los exámenes registrados por error. Quedan respaldados en Firebase."
            android:textColor="#B8C6D3"
            android:textSize="15sp" />

        <View
            android:layout_width="48dp"
            android:layout_height="3dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="16dp"
            android:background="@color/btn_Background_Acceder" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/FiltroOscuro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Persona">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/etPersonaExamenes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/FiltroOscuro.Texto" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/FiltroOscuro"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:hint="Año">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/etAnioExamenes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/FiltroOscuro.Texto" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/FiltroOscuro"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.6"
                android:hint="Examen">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/etTipoExamen"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/FiltroOscuro.Texto" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progresoExamenes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp" />

        <TextView
            android:id="@+id/txtResumenExamenes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="10dp"
            android:textColor="#B8C6D3"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/listaExamenesPersona"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
