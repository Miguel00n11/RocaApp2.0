<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:clipChildren="false">

    <!-- Capa trasera: botones de acción (se revelan al deslizar) -->
    <LinearLayout
        android:id="@+id/capaAcciones"
        android:layout_width="180dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/btnEditarSupervision"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="#FF9800"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtIconoAccionEditar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✎"
                android:textColor="#FFFFFF"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/txtLabelAccionEditar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Editar"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnEliminarSupervision"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="#F44336"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🗑"
                android:textColor="#FFFFFF"
                android:textSize="20sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Eliminar"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Capa frontal: contenido de la tarjeta -->
    <LinearLayout
        android:id="@+id/capaContenido"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#253341"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Fila superior: norma badge + fecha + badge autorizado -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtNormaRegistro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#FF9800"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="NMX-C-083"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/badgeAutorizado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="#1E4620"
                android:paddingHorizontal="6dp"
                android:paddingVertical="3dp"
                android:text="✓ Autorizado"
                android:textColor="#66BB6A"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/badgePendiente"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="#3E2A00"
                android:paddingHorizontal="6dp"
                android:paddingVertical="3dp"
                android:text="⏳ Pendiente"
                android:textColor="#FFA726"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/txtFechaRegistro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="08/10/2026"
                android:textColor="#8FA3B5"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Evaluado + evaluador -->
        <TextView
            android:id="@+id/txtEvaluadoRegistro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="José Adrián Cortés Martínez"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtEvaluadorRegistro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Por: Cristina Andrea Rodríguez Ortega"
            android:textColor="#8FA3B5"
            android:textSize="12sp" />

        <!-- Contadores S / NS / NA -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtResumenS"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:padding="4dp"
                android:text="S: 0"
                android:textColor="#4CAF50"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtResumenNS"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:padding="4dp"
                android:text="NS: 0"
                android:textColor="#F44336"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtResumenNA"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:padding="4dp"
                android:text="NA: 0"
                android:textColor="#8FA3B5"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
