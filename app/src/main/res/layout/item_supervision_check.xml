<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="#253341"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Número + Descripción -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/txtNumeroItem"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="top"
            android:background="#334455"
            android:gravity="center"
            android:text="1"
            android:textColor="#FF9800"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtDescripcionItem"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="Descripción del requisito"
            android:textColor="#D0E0EC"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- S / NS / NA -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnS"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:text="S"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnNS"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginHorizontal="4dp"
            android:layout_weight="1"
            android:text="NS"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnNA"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:text="NA"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Comentar toggle -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnComentar"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:minWidth="0dp"
            android:paddingHorizontal="6dp"
            android:text="＋ Comentar"
            android:textColor="#8FA3B5"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Hallazgos field (toggled por btnComentar) -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilHallazgos"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Comentario / Hallazgo"
        android:visibility="gone"
        app:boxStrokeColor="#FF9800"
        app:hintTextColor="#FF9800">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etHallazgos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="3"
            android:minLines="2"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />
    </com.google.android.material.textfield.TextInputLayout>
</LinearLayout>
