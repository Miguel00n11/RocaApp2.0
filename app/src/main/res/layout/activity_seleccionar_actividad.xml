<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerSeleccionar"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<!-- Contenido principal -->
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Banner de impersonación: visible solo cuando el admin está viendo como otro usuario -->
    <LinearLayout
        android:id="@+id/bannerImpersonacion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1565C0"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/txtBannerImpersonacion"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/white"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnSalirImpersonacion"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:minHeight="0dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="Volver a mi cuenta"
            android:textColor="@color/white"
            android:textSize="12sp"
            app:strokeColor="@color/white" />
    </LinearLayout>

    <!-- Barra superior: al tocarla se abre el panel lateral con la sesión -->
    <LinearLayout
        android:id="@+id/barraSesion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1f2a36"
        android:clickable="true"
        android:elevation="4dp"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="Abrir menú"
            android:src="@drawable/ic_menu_24" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:text="Laboratorio Roca"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtInicialesBarra"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_badge_examen"
            android:gravity="center"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/btn_Background_Cancelar"
        android:orientation="horizontal"
        android:layout_gravity="center"
        tools:context=".MainActivity">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:layout_marginVertical="6dp"

                android:orientation="horizontal">

                <androidx.cardview.widget.CardView
                    android:id="@+id/btnIrReportesCompactacion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="8dp"
                    android:layout_marginRight="6dp"
                    app:cardElevation="4dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="#232323"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <!-- Aquí puedes agregar cualquier otro contenido que desees dentro del CardView -->

                        <ImageView
                            android:id="@+id/imageView"
                            android:layout_width="150dp"
                            android:layout_height="150dp"
                            android:background="#232323"
                            android:scaleType="fitCenter"
                            android:src="@drawable/imagencala" /> <!-- Establecer la imagen deseada aquí -->

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Compactaciones"
                            android:textColor="@color/white"
                            android:textSize="18sp" />
                        <!-- También puedes agregar otros elementos como texto o botones aquí -->

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/btnIrReportesCilindros"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="6dp"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="4dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="#232323"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <!-- Aquí puedes agregar cualquier otro contenido que desees dentro del CardView -->

                        <ImageView
                            android:id="@+id/imageView1"
                            android:layout_width="150dp"
                            android:layout_height="150dp"
                            android:background="#232323"
                            android:scaleType="fitCenter"
                            android:src="@drawable/imagencilindros" /> <!-- Establecer la imagen deseada aquí -->

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Cilindros"
                            android:textColor="@color/white"
                            android:textSize="18sp" />
                        <!-- También puedes agregar otros elementos como texto o botones aquí -->

                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:gravity="center"
                android:layout_height="match_parent"
                android:layout_marginVertical="6dp"

                android:orientation="horizontal">

                <androidx.cardview.widget.CardView
                    android:id="@+id/btnItReportesMorteros"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="8dp"
                    android:layout_marginRight="6dp"

                    app:cardElevation="4dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="#232323"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <!-- Aquí puedes agregar cualquier otro contenido que desees dentro del CardView -->

                        <!-- Establecer la imagen deseada aquí -->

                        <ImageView
                            android:id="@+id/imageView2"
                            android:layout_width="150dp"
                            android:layout_height="150dp"
                            android:background="#232323"
                            android:scaleType="fitCenter"
                            android:src="@drawable/imagenmortero" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Morteros"
                            android:textColor="@color/white"
                            android:textSize="18sp" />
                        <!-- También puedes agregar otros elementos como texto o botones aquí -->

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/btnIrReportesVigas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="6dp"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="4dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="#232323"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <!-- Aquí puedes agregar cualquier otro contenido que desees dentro del CardView -->

                        <!-- Establecer la imagen deseada aquí -->

                        <ImageView
                            android:id="@+id/imageView3"
                            android:layout_width="150dp"
                            android:layout_height="150dp"
                            android:background="#232323"
                            android:scaleType="fitCenter"
                            android:src="@drawable/imagenvigas" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Vigas"
                            android:textColor="@color/white"
                            android:textSize="18sp" />
                        <!-- También puedes agregar otros elementos como texto o botones aquí -->

                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:gravity="center"
                android:layout_height="match_parent"
                android:layout_marginVertical="6dp"
                android:orientation="horizontal">

                <androidx.cardview.widget.CardView
                    android:id="@+id/btnIrReportesMecanicas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="4dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="#232323"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <ImageView
                            android:id="@+id/imageView4"
                            android:layout_width="150dp"
                            android:layout_height="150dp"
                            android:background="#232323"
                            android:scaleType="fitCenter"
                            android:src="@drawable/imagenmecanica" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Mecánicas"
                            android:textColor="@color/white"
                            android:textSize="18sp" />

                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>
        </LinearLayout>


    </ScrollView>

</LinearLayout>

<!-- Panel lateral con la sesión -->
<LinearLayout
    android:id="@+id/panelSesion"
    android:layout_width="300dp"
    android:layout_height="match_parent"
    android:layout_gravity="start"
    android:background="#1f2a36"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical">

    <!-- Encabezado con los datos del usuario -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/btn_Background_Seleccionar_Actividad"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="32dp"
        android:paddingBottom="20dp">

        <TextView
            android:id="@+id/txtInicialesSesion"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_badge_examen"
            android:gravity="center"
            android:textColor="@color/white"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Sesión iniciada como"
            android:textColor="#8FA3B5"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/txtNombreSesion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtPuestoSesion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#B8C6D3"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/txtCorreoSesion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#8FA3B5"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/txtAdminSesion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_estado_examen"
            android:backgroundTint="@color/btn_Background_Acceder"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp"
            android:text="Administrador"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#4B5E6C"
        android:layout_marginTop="8dp" />

    <!-- Navegación: Capacitaciones -->
    <LinearLayout
        android:id="@+id/navCapacitaciones"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:scaleType="fitCenter"
            android:contentDescription="@null"
            android:src="@drawable/imagen_capacitaciones" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:text="Capacitaciones"
            android:textColor="@color/white"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Navegación: Mis equipos -->
    <LinearLayout
        android:id="@+id/navEquiposPredeterminados"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:scaleType="fitCenter"
            android:contentDescription="@null"
            android:src="@drawable/ic_build_24"
            app:tint="@color/white" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:text="Mis equipos"
            android:textColor="@color/white"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Navegación: Administrar personal (solo admins) -->
    <LinearLayout
        android:id="@+id/navAdministrarPersonal"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:scaleType="fitCenter"
            android:contentDescription="@null"
            android:src="@drawable/baseline_person_24"
            app:tint="@color/btn_Background_Acceder" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:text="Administrar personal"
            android:textColor="@color/white"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Navegación: Supervisiones -->
    <LinearLayout
        android:id="@+id/navSupervisiones"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:scaleType="fitCenter"
            android:contentDescription="@null"
            android:src="@drawable/ic_chevron_right_24"
            app:tint="#FF9800" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:text="Supervisiones"
            android:textColor="@color/white"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Navegación: Instructivos -->
    <LinearLayout
        android:id="@+id/navInstructivos"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:scaleType="fitCenter"
            android:contentDescription="@null"
            android:src="@drawable/ic_edit_24"
            app:tint="#4CAF50" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:text="Instructivos"
            android:textColor="@color/white"
            android:textSize="16sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Cambiar de usuario (solo admins / modo impersonación) -->
    <LinearLayout
        android:id="@+id/navCambiarUsuario"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/iconCambiarUsuario"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_chevron_right_24"
            app:tint="#64B5F6" />

        <TextView
            android:id="@+id/txtCambiarUsuario"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:text="Cambiar de usuario"
            android:textColor="#64B5F6"
            android:textSize="16sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#4B5E6C" />

    <!-- Cerrar sesión -->
    <LinearLayout
        android:id="@+id/btnCerrarSesion"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_logout_24"
            app:tint="#EF5350" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:text="Cerrar sesión"
            android:textColor="#EF5350"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
