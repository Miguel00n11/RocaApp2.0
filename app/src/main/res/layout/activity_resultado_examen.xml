<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#f2f2f2"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="RESULTADO DEL EXAMEN"
            android:textStyle="bold"
            android:textSize="24sp"
            android:textColor="#111111"
            android:gravity="center"
            android:layout_marginBottom="20dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:elevation="4dp"
            android:background="@android:color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/txtNombreResultado"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="NOMBRE:"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/txtFechaResultado"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="FECHA:"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:layout_marginBottom="8dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#cccccc"
                    android:layout_marginVertical="12dp" />

                <TextView
                    android:id="@+id/txtTotalPreguntas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="PREGUNTAS:"
                    android:textSize="16sp"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/txtAciertos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ACIERTOS:"
                    android:textSize="16sp"
                    android:textColor="#2e7d32"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#cccccc"
                    android:layout_marginVertical="12dp" />

                <TextView
                    android:id="@+id/txtCalificacion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="CALIFICACIÓN:"
                    android:textStyle="bold"
                    android:textSize="20sp"
                    android:textColor="#1565c0"
                    android:gravity="center"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:id="@+id/txtEstado"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ESTADO:"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:gravity="center"
                    android:layout_marginBottom="8dp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <Button
            android:id="@+id/btnVolverCapacitaciones"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Volver a Capacitaciones"
            android:textSize="16sp" />

    </LinearLayout>
</ScrollView>

